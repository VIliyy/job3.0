# Job3.0 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 应用配置 ====================
APP_NAME=Job3.0
APP_VERSION=1.0.0
DEBUG=false

# ==================== 数据库配置 ====================
# SQLite (默认，无需修改)
DATABASE_URL=sqlite:///./job3.db

# PostgreSQL (可选)
# DATABASE_URL=postgresql://user:password@localhost:5432/job3

# ==================== AI API Keys ====================
# DeepSeek API Key (推荐)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI API Key (可选)
# OPENAI_API_KEY=sk-your-openai-api-key

# ==================== Redis (可选) ====================
# REDIS_URL=redis://localhost:6379

# ==================== 安全配置 ====================
# JWT密钥 (生产环境必须修改)
SECRET_KEY=change-this-secret-key-in-production

# ==================== CORS配置 ====================
# 允许的前端域名
CORS_ORIGINS=http://localhost:5173,http://localhost:80
