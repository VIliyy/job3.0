# ============================================
# Job3.0 .gitignore
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyc
*.class

# Virtual environments
venv/
env/
.venv/
ENV/

# ============================================
# ⚠️ 敏感信息 - 绝对不能提交
# ============================================

# 环境变量配置
.env
.env.local
.env.*.local

# API 密钥和凭证
*.pem
*.key
credentials.json
secrets.json

# 数据库
*.db
*.sqlite
*.sqlite3
*.db.backup
job3.db

# 上传的文件（包含用户简历）
uploads/*
!uploads/.gitkeep

# 敏感备份
*_backup*
sensitive_backup*

# 日志
*.log
logs/

# ============================================
# IDE 和编辑器
# ============================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================
# 依赖
# ============================================
node_modules/
frontend/node_modules/
backend/node_modules/

# 构建产物
frontend/dist/
frontend/build/
*.egg-info/

# 测试覆盖率
.coverage
htmlcov/

# 备份文件
*.bak
*~
