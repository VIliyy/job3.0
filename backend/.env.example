# ============================================
# Job3.0 环境变量配置示例
# ============================================
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 填写真实的配置值
# 3. 不要将 .env 文件提交到 GitHub！
# ============================================

# ============================================
# AI API Keys（至少配置一个）
# ============================================

# DeepSeek API（推荐）
# 注册地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI API（可选）
# OPENAI_API_KEY=sk-your-openai-api-key

# ============================================
# Ollama 本地模型（可选，用于离线）
# ============================================
# 安装: https://ollama.com/
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ============================================
# 安全配置
ENVIRONMENT=development
# ============================================

# JWT 密钥（生产环境必须修改）
# 生成随机密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-a-random-secret-key-here

# ============================================
# 数据库配置
# ============================================

# SQLite（默认，无需修改）
DATABASE_URL=sqlite:///./job3.db
PUBLIC_UPLOADS=true

# MySQL（可选）
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/job3_db

# ============================================
# 应用配置
# ============================================
APP_NAME=Job3.0
DEBUG=false


# ============================================
# 视频笔记模块（小林工具箱）
# ============================================

# Whisper 模型大小: tiny / base / small / medium / large-v3
# WHISPER_MODEL_SIZE=tiny

# 转写设备: auto / cpu / cuda
# WHISPER_DEVICE=auto

# 视频笔记专用 LLM（可选；不配置则按优先级用 OPENAI_API_KEY > DEEPSEEK_API_KEY > Ollama）
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat


# 浏览器扩展桥接 Token（海投助手本地桥，扩展 X-Bridge-Token 需一致）
BRIDGE_TOKEN=generate-a-random-bridge-token-here
